# Copy to deploy/oracle/.env on the VM (chmod 600) and fill it in there, never in git.
# Free hostname from duckdns.org pointing at the VM's public IP; api.<DOMAIN> works too.
DOMAIN=elregista.duckdns.org

# Same values the Vercel project el-regista-api had.
DATABASE_URL=
INGESTION_API_KEY=
VISIT_SALT=
NEON_API_KEY=
NEON_PROJECT_ID=

# Only with the "localdb" profile (Postgres on this VM instead of Neon):
# DATABASE_URL=postgresql+psycopg://scouting:<password>@db:5432/scouting
LOCAL_DB_PASSWORD=
